# ==========================================
# Seneca Academy LMS — Environment Variables
# ==========================================

# MongoDB Connection URI (MongoDB Atlas or Local replica)
MONGODB_URI=mongodb://localhost:27017/seneca_school_lms

# Authentication Secret for Jose JWT Sessions (Min 32 characters)
AUTH_SECRET=super_secret_seneca_academy_auth_token_key_change_in_production_2026

# Public App Base URL & Canonical Domain
NEXT_PUBLIC_APP_URL=https://senecaacademy.school
NEXT_PUBLIC_CANONICAL_URL=https://senecaacademy.school

# Allowed Production Domains (comma-separated, supports subdomains)
ALLOWED_HOSTS=senecaacademy.school,www.senecaacademy.school,seneca.edu.pk,www.seneca.edu.pk
NEXT_PUBLIC_ALLOWED_HOSTS=senecaacademy.school,www.senecaacademy.school,seneca.edu.pk,www.seneca.edu.pk

# Optional: Set to 'true' to completely disable domain integrity redirection
DISABLE_DOMAIN_GUARD=false
NEXT_PUBLIC_DISABLE_DOMAIN_GUARD=false

# Cloud Storage Provider (cloudinary | s3 | r2 | local)
STORAGE_PROVIDER=cloudinary

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default School Identifier for Multi-tenant Fallback
DEFAULT_SCHOOL_CODE=SENECA-MAIN-001
