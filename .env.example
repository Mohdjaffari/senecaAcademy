# ==========================================
# Seneca Academy LMS — Environment Variables
# ==========================================

# MongoDB Connection URI (MongoDB Atlas or Local replica)
MONGODB_URI=mongodb://localhost:27017/seneca_school_lms

# Authentication Secret for Jose JWT Sessions (Min 32 characters)
AUTH_SECRET=super_secret_seneca_academy_auth_token_key_change_in_production_2026

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloud Storage Provider (cloudinary | s3 | r2 | local)
STORAGE_PROVIDER=cloudinary

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default School Identifier for Multi-tenant Fallback
DEFAULT_SCHOOL_CODE=SENECA-MAIN-001
